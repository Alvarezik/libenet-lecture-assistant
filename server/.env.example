# ==========================================
# LibeNet Lecture Assistant - Server Config
# ==========================================

# ==================== DATABASE CONFIG ====================
DB_HOST=localhost
DB_PORT=3306
DB_USER=libenet_user
DB_PASS=your_database_password_here
DB_NAME=libenet_db

# ==================== JWT AUTH ====================
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30

# ==================== UNIVERSAL LLM & REASONING (ANY PROVIDER) ====================
# Supports any OpenAI-compatible API or local model runner:
# - Groq: https://api.groq.com/openai/v1 (model: llama-3.3-70b-versatile)
# - DeepSeek: https://api.deepseek.com/v1 (model: deepseek-chat)
# - OpenAI: https://api.openai.com/v1 (model: gpt-4o-mini)
# - OpenRouter: https://openrouter.ai/api/v1 (model: deepseek/deepseek-chat)
# - Ollama (Local): http://localhost:11434/v1 (model: llama3.2)
# - LM Studio (Local): http://localhost:1234/v1
# - OrcaRouter: https://api.orcarouter.ai/v1 (model: deepseek/deepseek-v4-flash-free)

LLM_PROVIDER=auto
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Direct Provider Keys (Optional - automatic multi-tier failover cascade)
GROQ_API_KEY=your_groq_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
ORCAROUTER_API_KEY=your_orcarouter_api_key_here

# ==================== UNIVERSAL STT (AUDIO TRANSCRIPTION) ====================
# Supports:
# 1. Groq Whisper: Free & blazing fast (whisper-large-v3-turbo)
# 2. Deepgram Nova-2: Optimized for noisy lecture halls and Russian terminology
# 3. Gladia Audio AI: Built-in audio enhancer & speech isolation
# 4. AssemblyAI Universal: Failover transcription
# 5. Local / Custom Whisper API: http://localhost:9000/v1/audio/transcriptions

DEEPGRAM_API_KEY=your_deepgram_key_here
GLADIA_API_KEY=your_gladia_key_here
ASSEMBLYAI_API_KEY=your_assemblyai_key_here
WHISPER_BASE_URL=https://api.groq.com/openai/v1/audio/transcriptions

# ==================== STORAGE & SERVER ====================
UPLOAD_DIR=uploads
HOST=0.0.0.0
PORT=8100
